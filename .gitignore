# Build output and local scratch
dist/
build/
__pycache__/
*.pyc
.venv/
tools/gh/

# The installer itself is published as a release asset, not committed:
# a 79 MB binary in the history would make every clone painful.
installer/*.exe

# Snapshots of previous builds. Useful locally, not something anyone
# else needs a copy of.
backup/

# Personal settings and anything captured while testing
settings.json
output/
_*.py
_*.png
_*.txt
_*.md
_*.ps1
_*.webm
# Scratch folders the test suites create. These hold fake checkpoints
# of several hundred megabytes, and one of them was very nearly
# committed.
_*/
build_all.txt

# Tool caches, reports and editor/OS noise
*.log
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
.idea/
.DS_Store
Thumbs.db

# Source-mode runtime data. Older builds wrote these directly at repo root;
# the application now migrates them into .wispwasp-data/.
.wispwasp-data/
prompts.json
favourite_prompts.json
styles.json
sounds/
scratch/
